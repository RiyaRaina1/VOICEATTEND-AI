# VoiceAttend Environment Configuration
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# === Data & Database ===
# VOICEATTEND_DATA_DIR=./data
# VOICEATTEND_DB_PATH=./data/voiceattend.db

# === Speaker Recognition ===
# SPEAKER_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
# VOICEATTEND_SIMILARITY_THRESHOLD=0.72
# VOICEATTEND_AMBIGUOUS_MARGIN=0.05

# === Speech Command Verification ===
# WHISPER_MODEL_SIZE=tiny

# === Authentication ===
# Set to 1 to enable login gate on all pages.
# For single-user local installations, leave as 0.
# VOICEATTEND_ENABLE_AUTH=0
